# Copy to .env.pipeline (git-ignored) and fill in your own values. Nothing site-specific belongs in the repository.
OPENAI_API_KEY=local
LLM_API_URL=http://llm-host.example:11434/v1/chat/completions
LLM_MODEL=your-model
# Optional: time zone for run IDs and daily dates (default America/New_York).
# TZ=America/New_York
# The host data directory is set by HN_BRIEF_DATA_DIR in the shell or a Compose .env file
# (default ./data); Compose does not read it from this file.
# Optional: fetch each story's linked page through Firecrawl (https://firecrawl.dev, free plan is enough)
# so summaries are written from the article itself. Pages over 12,000 characters are summarized in
# overlapping parts first. Without a key, summaries use the title and comments only.
# FIRECRAWL_API_KEY=fc-...
# Optional: Reddit blocks Firecrawl, so reddit.com links are read through the Reddit API with a
# "script" app from https://www.reddit.com/prefs/apps (app-only access, no username or password).
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...
